def main():
    print("\n" + "-"*40)

    print("🟠  MICHELANGELO  —  SCOREBOARD SCOUT")

    print("📅", time.strftime("%A, %B %d, %Y — %I:%M %p"))

    print("📡  METHODS: Bing → Yahoo → MLB Official")

    print("⏱️  REFRESH: Every 60 seconds")

    print("-"*40 + "\n")
    
    show_glassnotes()
    
    spinner = samba_lambda_spin()
    cycle = 0
    global previous_scores
    
    while True:
        cycle += 1
        s = next(spinner)
        print(f"\r  {ORG}{s}{R}  {time.strftime('%I:%M:%S %p')}  |   CHECKING.....", end="", flush=True)
        
        games, source = scout_full_page()
        
        if not games:
            time.sleep(60)
            continue
        
        changes = check_score_changes(games)
        for change in changes:
            send_score_notification(change)
            generate_jarvis_mp3(change)
        
        output = darwin_format(games, source)
        print("\n" + output)
        
        # ─── SAVE TXT (Mikey's original) ───
        txt_file = DATA_DIR / f"{source}_scoreboard.txt"
        with open(txt_file, 'w', encoding='utf-8') as f:
            f.write(output)
        print(f"  💾  Saved TXT to {txt_file}")
        
        # ─── SAVE JSON (NEW: Alfred & Master Art) ───
        save_scores_for_alfred(games, source)

        # ─── SAVE HTML (raw rendered page for inspection) ───
        html_file = DATA_DIR / f"{source}_scoreboard.html"
        try:
            # copy the raw fetched html to the named file
            raw = (DATA_DIR / "yahoo_scorefeed.html").read_text(encoding='utf-8')
            html_file.write_text(raw, encoding='utf-8')
            print(f"  💾  Saved HTML to {html_file}")
        except Exception as e:
            print(f"  ⚠️ Could not save HTML: {e}")

        
        print(f"\r  {GRN}[DONE]  Cycle {cycle} complete. {len(games)} games found. Waiting 60...{R}")
        mikey_countdown(60)
