def read_glassnotes():
    try:
        with open(GLASSNOTES, 'r', encoding='utf-8') as f:
            content = f.read()
        print(f"  {ORG}🟠  GlassNotes loaded!{R}")
        return content
    except Exception as e:
        print(f"  {RED}❌  GlassNotes not found: {e}{R}")
        return None

def strip_html(html):
    html = re.sub(r'<style[^>]*>.*?</style>', '', html, flags=re.DOTALL)
    html = re.sub(r'<script[^>]*>.*?</script>', '', html, flags=re.DOTALL)
    html = re.sub(r'<[^>]+>', ' ', html)
    html = re.sub(r'\s+', ' ', html)
    return html.strip()

def extract_intel(html):
    clean = strip_html(html)
    clean = clean.replace('&nbsp;', ' ')
    clean = re.sub(r'\s+', ' ', clean)
    clean = re.sub(r'\.\s+', '.\n  • ', clean)
    
    game_pattern = r'(Yesterday|Today|Tomorrow)\s+([A-Za-z\s]+?)\s+([A-Za-z\s]+?)\s+(\d+)\s+(\d+)\s+Final'
    games = re.findall(game_pattern, clean, re.IGNORECASE)
    
    lines = []
    if games:
        lines.append("🟠 MICHELANGELO — GAME RESULTS")
        lines.append("")
        for g in games[:10]:
            day, team1, team2, score1, score2 = g
            lines.append(f"  • {day}: {team1.strip()} {score1} - {score2} {team2.strip()}")
    
    if lines:
        lines.append("")
        lines.append("📋 FULL GLASSNOTES TEXT:")
        lines.append(clean[:5000])
    
    return "\n".join(lines) if lines else clean[:5000]

MIKEY_BRAIN = read_glassnotes()

def show_glassnotes():
    if MIKEY_BRAIN:
        intel = extract_intel(MIKEY_BRAIN)
        print(f"\n  {ORG}📋  MIKEY'S INTEL{R}")
