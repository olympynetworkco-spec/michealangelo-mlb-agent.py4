def darwin_format(games, source):
    output = []
    output.append("-" * 40)
    output.append(f"⚾  MLB SCOREBOARD  —  {time.strftime('%A, %B %d, %Y — %I:%M %p')}  🟠🐢")
    output.append("-" * 40)

    if games:
        output.append(f"  📡 Source: {source.upper()}")
        output.append("")
        output.append("  📅 GAMES:")
        output.append("  " + "-" * 40)

        for i, game in enumerate(games, 1):
            team1 = game.get('team1', '?')
            team2 = game.get('team2', '?')
            score1 = game.get('score1', '0')
            score2 = game.get('score2', '0')
            status = game.get('status', 'Scheduled')
            inning = game.get('inning', '')

            # ── game header line ──
            if status == 'Final':
                output.append(f"  {i:2}. {team1:22} {score1} — {score2} {team2:22}  [DONE] Final")
            elif status == 'Live':
                line = f"  {i:2}. {team1:22} {score1} — {score2} {team2:22}  ⚾ Live"
                if inning:
                    line += f"  ·  {inning}"
                output.append(line)
            else:
                output.append(f"  {i:2}. {team1:22} vs {team2:22}  ⏰ Scheduled")

            # ── TIMELINE BLOCK — one line per game underneath ──
            output.append("      ┌─ TIMELINE ────────────────────────────────────")
            output.append(f"      │  inning   : {inning or '—'}")
            output.append(f"      │  outs     : {game.get('count', {}).get('outs', '—')}")
            output.append(f"      │  balls    : {game.get('count', {}).get('balls', '—')}")
            output.append(f"      │  strikes  : {game.get('count', {}).get('strikes', '—')}")
            output.append(f"      │  bases    :")
            diamond = draw_bases(game.get('bases', {}))
            for dline in diamond.split("\n"):
                output.append(f"      │    {dline}")
            output.append("      └───────────────────────────────────────────────")
            output.append("")

        output.append(f"  📊 {len(games)} games total")
    else:
        output.append("  ⏳ No games found")

    output.append("")
    output.append("-" * 40)
    return "\n".join(output)
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| CHAPTER 2: 𝒊 β beta — IMPORTS + PATHS (already at top)
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

# ─── SCORE CHANGE TRACKER ───
previous_scores = {}

def check_score_changes(games):
    """Check for score changes and send notifications"""
    global previous_scores
    
    changes = []
    
    for g in games:
        # Create a unique key for each game
        team1 = g.get('team1', '')
        team2 = g.get('team2', '')
        game_key = f"{team1}|{team2}"
        
        # Get current scores
        score1 = g.get('score1', '0')
        score2 = g.get('score2', '0')
        current_score = f"{score1}-{score2}"
        status = g.get('status', 'Unknown')
        
        # Check if we've seen this game before
        if game_key in previous_scores:
            prev_score = previous_scores[game_key]
            
            # If score changed, record it
            if prev_score != current_score:
                changes.append({
                    'game': f"{team1} @ {team2}",
                    'old': prev_score,
                    'new': current_score,
                    'status': status
                })
        
        # Update previous score
        previous_scores[game_key] = current_score
    
    return changes


#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--| BASES — read 1st/2nd/3rd occupancy from a Yahoo game card
#+--| prints ASCII diamond + stashes game['bases'] and game['inning']
#+--| micheal read some fucking bases and tell who's on base would yah spinner?
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def draw_bases(bases):
    """ASCII diamond. Occupied = ●  Empty = ○
            2nd
         3rd   1st
            home
    """
    b2 = '●' if bases.get('second') else '○'
    b3 = '●' if bases.get('third')  else '○'
    b1 = '●' if bases.get('first')  else '○'
    return (
        f"      {b2}      \n"
        f"   {b3}   {b1}   \n"
        f"      ⌂      "
    )


def read_bases(game_card_html):
    """
    Returns (bases_dict, inning_str)
    bases_dict = {'first': bool, 'second': bool, 'third': bool, 'home': False}

    Two shapes Yahoo uses — either works with this:

    Shape A (class-based):
      <div class="bases">
        <span class="base first occupied"></span>
        <span class="base second"></span>
        <span class="base third occupied"></span>
      </div>

    Shape B (svg fill-based):
      <svg class="base-diamond">
        <polygon points="..." fill="#fff" />     ← occupied
        <polygon points="..." fill="#2b323d" />  ← empty
        <polygon points="..." fill="#fff" />
      </svg>
    """
    bases = {'first': False, 'second': False, 'third': False, 'home': False}
    inning = ''

    # ── inning text: "Top 3rd", "Bot 7th", "Mid 5th", "End 8th"
    m = re.search(
        r'(Top|Bot|Bottom|Mid|End)\s+(\d+)(?:st|nd|rd|th)?',
        game_card_html, re.IGNORECASE
    )
    if m:
        half = m.group(1).capitalize()
        if half == 'Bottom': half = 'Bot'
        inning = f"{half} {m.group(2)}"

    # ── Shape A: class="base first occupied"
    for slot in ('first', 'second', 'third'):
        if re.search(
            rf'class="[^"]*base[^"]*{slot}[^"]*occupied[^"]*"',
            game_card_html, re.IGNORECASE
        ):
            bases[slot] = True

    # ── Shape B: svg polygon fills — occupied = white / #fff / #ffffff
    if not any(bases.values()):
        polys = re.findall(
            r'<polygon[^>]*fill="(#[0-9a-fA-F]{3,6}|white)"',
            game_card_html
        )
        if len(polys) >= 3:
            for i, slot in enumerate(('first', 'second', 'third')):
                fill = polys[i].lower()
                if fill in ('#fff', '#ffffff', 'white'):
                    bases[slot] = True

    return bases, inning


def fill_bases_for_game(game):
    card_html = game.get('_card_html', '')
    bases, inning = read_bases(card_html)
    game['bases']  = bases
    game['inning'] = inning
    game['count']  = {'balls': 0, 'strikes': 0, 'outs': 0}
    return game
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--|chime chime chime alert
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def send_score_notification(change):
    """Send macOS notification for score change"""
    try:
        script = f'''
        display notification "{change['game']}: {change['old']} → {change['new']}" with title "⚾ SCORE CHANGE" subtitle "{change['status']}" sound name "Ping"
        '''
        subprocess.run(['osascript', '-e', script], capture_output=True, timeout=5)
        print(f"  {ORG}🔔 Score change!{R}")
        print(f"  {GRN}  {change['game']}: {change['old']} → {change['new']}{R}")
    except Exception as e:
        print(f"  {RED}⚠️ Notification failed: {e}{R}")
