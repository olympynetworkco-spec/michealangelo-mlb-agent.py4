#+--| CHAPTER 3: 𝒊 ε epsilon — DEFINITIONS (helpers)
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def samba_lambda_spin():
    spin_chars = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
    idx = 0
    while True:
        yield spin_chars[idx % len(spin_chars)]
        idx += 1
        time.sleep(0.08)

def exit_handler(sig, frame):
    print(f"\n  {ORG}🟠  Mikey dropping the nunchucks...{R}")
    print(f"  {ORG}🟠  COWABUNGA forever. ❤️{R}\n")
    sys.exit(0)

signal.signal(signal.SIGINT, exit_handler)
signal.signal(signal.SIGTERM, exit_handler)
