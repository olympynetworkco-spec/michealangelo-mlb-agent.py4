def mikey_countdown(seconds=120):
    spin = samba_lambda_spin()
    for remaining in range(seconds, 0, -1):
        for _ in range(12):                          # 12 frames per second
            frame = next(spin)
            print(f"\r   {frame}  i am checking… refreshing in {remaining:3}s sir ", end='', flush=True)
            time.sleep(0.08)                         # matches your generator's beat
    print("\r   [DONE]  cycle complete — checking now…                              ")

