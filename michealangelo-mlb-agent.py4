# ─── JARVIS MP3 VOICE ALERT ───
def generate_jarvis_mp3(change):
    """Generate Thomas voice MP3 on score change. Atomic write.
       Wording matches the MLB dashboard's jarvisSpeak() exactly.
       Writes to thomas_voice.mp3 — the same file the dashboard watches."""
    mp3_final = DATA_DIR / "thomas_voice.mp3"
    mp3_tmp = DATA_DIR / "thomas_voice.tmp.mp3"

    # Build the spoken line — same phrasing as dashboard
    text = f"Sir, score change detected. {change['game']}. {change['old']} to {change['new']}."

    try:
        subprocess.run([
            "edge-tts",
            "--voice", THOMAS_VOICE,
            "--text", text,
            "--write-media", str(mp3_tmp)
        ], check=True, timeout=15)

        # Atomic swap — browser never sees a half-written file
        os.replace(mp3_tmp, mp3_final)
        print(f"  {GRN}🎩 Thomas voice dropped: {mp3_final.name}{R}")
        return True
    except FileNotFoundError:
        print(f"  {YLW}⚠️  edge-tts not installed — run: pip install edge-tts{R}")
        return False
    except Exception as e:
        print(f"  {RED}⚠️ MP3 failed: {e}{R}")
        return False


