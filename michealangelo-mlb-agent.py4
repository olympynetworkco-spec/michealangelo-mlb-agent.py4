def save_scores_for_alfred(games, source="YAHOO_LIVE"):
    """
    🎩 MichaelAngelo → Alfred → Master Art
    Saves scores in the exact format Alfred's HTML expects
    """
    from datetime import datetime
    import json
    
    data = {
        "source": source.upper(),
        "fetched_at": datetime.now().isoformat(),
        "total": len(games),
        "games": []
    }
    
    for game in games:
        team1 = game.get('team1', 'Unknown')
        team2 = game.get('team2', 'Unknown')
        score1 = game.get('score1', '0')
        score2 = game.get('score2', '0')
        status = game.get('status', 'Scheduled')
        
        # Determine winners
        try:
            s1 = int(score1)
            s2 = int(score2)
        except:
            s1, s2 = 0, 0
        
        away_winner = s1 > s2
        home_winner = s2 > s1
        
        data["games"].append({
            "away": team1,
            "home": team2,
            "away_score": str(score1),
            "home_score": str(score2),
            "status": status,
            "away_winner": away_winner,
            "home_winner": home_winner
        })
    
    # Save to Alfred's expected location
    json_path = DATA_DIR / "mlbscores.json"
    with open(json_path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    
    print(f"  💾  JSON saved for Alfred: {json_path}")
    return json_path

