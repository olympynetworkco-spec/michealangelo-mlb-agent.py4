#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>

def parse_yahoo_live(text):
    """Parse Yahoo live scores from raw text."""
    games = []
    lines = text.strip().split('\n')
    
    for line in lines:
        # Pattern: "BREW 9 - CHC 5"
        match = re.search(r'([A-Z]{2,4})\s+(\d+)\s*-\s*([A-Z]{2,4})\s+(\d+)', line)
        if match:
            team1 = match.group(1)
            score1 = match.group(2)
            team2 = match.group(3)
            score2 = match.group(4)
            
            # Map abbreviations to full names
            team_names = {
                'NYY': 'Yankees', 'LAA': 'Angels',
                'BREW': 'Brewers', 'CHC': 'Cubs',
                'BOS': 'Red Sox', 'SEA': 'Mariners',
                'CWS': 'White Sox', 'HOU': 'Astros',
                'TB': 'Rays', 'NYM': 'Mets',
                'PIT': 'Pirates'
            }
            
            games.append({
                'team1': team_names.get(team1, team1),
                'team2': team_names.get(team2, team2),
                'score1': score1,
                'score2': score2,
                'status': 'Live'
            })
    
    return games

#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--|mlb oficial parse
#+--|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>>
#+--|

def parse_mlb_official(html):
    games = []
    seen_games = set()
    
    # Look for team names in the HTML
    team_pattern = r'<span[^>]*class="[^"]*team-name[^"]*"[^>]*>([^<]+)</span>'
    teams = re.findall(team_pattern, html)
    
    # Look for scores
    score_pattern = r'<span[^>]*class="[^"]*score[^"]*"[^>]*>(\d+)</span>'
    scores = re.findall(score_pattern, html)
    
    # Look for status
    status_pattern = r'<span[^>]*class="[^"]*status[^"]*"[^>]*>([^<]+)</span>'
    statuses = re.findall(status_pattern, html)
    
    # Pair teams and scores
    for i in range(0, len(teams), 2):
        if i + 1 < len(teams):
            team1 = teams[i].strip()
            team2 = teams[i+1].strip()
            game_key = f"{team1}|{team2}"
            if game_key in seen_games:
                continue
            seen_games.add(game_key)
            
            score1 = scores[i] if i < len(scores) else "0"
            score2 = scores[i+1] if i+1 < len(scores) else "0"
            status = statuses[i//2] if i//2 < len(statuses) else "Scheduled"
            
            game = {
                "team1": team1,
                "team2": team2,
                "score1": score1,
                "score2": score2,
                "status": status,
                "day": "Today",
                "time": None
            }
            games.append(game)
    
    return games

