def parse_bing_html(html):
    games = []
    seen_games = set()
    
    # Scheduled games
    pattern = r'aria-label="See more details about ([^,]+) vs ([^,]+), (Today|Tomorrow), ([^"]+)"'
    matches = re.findall(pattern, html)
    for match in matches:
        team1, team2, day, time_info = match
        game_key = f"{team1}|{team2}"
        if game_key in seen_games:
            continue
        seen_games.add(game_key)
        game = {"team1": team1.strip(), "team2": team2.strip(), "time": time_info.strip(), "day": day, 
                "status": "Scheduled", "score1": None, "score2": None}
        games.append(game)
    
    # Completed games
    score_pattern = r'([A-Za-z\s]+?)\s+(\d+)\s*[-–]\s*(\d+)\s+([A-Za-z\s]+?)(?:\s*\(FINAL\)|\s*\(Final\))'
    score_matches = re.findall(score_pattern, html, re.IGNORECASE)
    for match in score_matches:
        team1, team2 = match[0].strip(), match[3].strip()
        game_key = f"{team1}|{team2}"
        if game_key in seen_games:
            continue
        seen_games.add(game_key)
        game = {"team1": team1, "score1": match[1], "score2": match[2], "team2": team2, 
                "status": "Final", "day": "Today", "time": None}
        games.append(game)
    
    # Live games
    live_pattern = r'aria-label="See more details about ([^,]+) vs ([^,]+), ([^,]+) (\d+), ([^,]+) (\d+), ([^"]+)"'
    live_matches = re.findall(live_pattern, html)
    for match in live_matches:
        team1, team2, score1, score2, status = match[0].strip(), match[1].strip(), match[3], match[5], match[6].strip()
        game_key = f"{team1}|{team2}"
        if game_key in seen_games:
            continue
        seen_games.add(game_key)
        game = {"team1": team1, "team2": team2, "score1": score1, "score2": score2, 
                "status": "Live", "day": "Today", "time": status}
        games.append(game)
    
    return games
