# ─── SPEAK (Edge TTS) ───
async def speak(text, voice=THOMAS_VOICE):
    """Nureal Thomas speaks using Edge TTS"""
    try:
        communicate = edge_tts.Communicate(text, voice)
        # Save to data folder and play
        voice_file = DATA_DIR / "thomas_voice.mp3"
        await communicate.save(str(voice_file))
        # Play it
        import subprocess
        subprocess.run(['afplay', str(voice_file)], check=False)

    except edge_tts.exceptions.NoAudioReceived:
        print("❌ NoAudioReceived — try downgrading edge-tts to 7.2.0")
    except Exception as e:
        print(f"❌ TTS error: {e}")
#+--|------------------------------------------->>>>
#+--| chapter 3 :DARWIN 7 DEF download Thomas for neural speech
